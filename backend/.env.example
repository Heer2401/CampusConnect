NODE_ENV=development
PORT=5000
MONGO_URI=mongodb://localhost:27017/campusconnect
JWT_SECRET=your_jwt_secret_here
CLIENT_URL=http://localhost:3000
REDIS_URL=redis://localhost:6379
# AI Microservice & Health Monitoring 
AI_SERVICE_URL=http://localhost:8000
AI_HEALTH_TIMEOUT_MS=5000

# Marketplace & Listing Management Module (Nishka Shah)
# Controls initial listing status: 'true' (active immediately in dev) or 'false' (pending_approval in prod)
LISTING_AUTO_APPROVE=true
# Storage provider for uploaded listing images: 'local' or 'cloudinary'
IMAGE_STORAGE=local
# Local storage upload directory (relative or absolute)
UPLOAD_DIR=uploads/marketplace
# Maximum single image upload size in megabytes (default: 5)
MAX_IMAGE_SIZE_MB=5
# Maximum number of images allowed per listing (default: 6)
MAX_IMAGES_PER_LISTING=6
# Cloudinary credentials (required only when IMAGE_STORAGE=cloudinary)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
# Alternatively, full connection string:
# CLOUDINARY_URL=cloudinary://your_api_key:your_api_secret@your_cloud_name


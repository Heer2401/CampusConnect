# CampusConnect AI Service Environment Variables
# Copy to .env and configure for local development

# Groq API Key (get from https://console.groq.com/keys)
GROQ_API_KEY=your_groq_api_key_here

# Mode: 'false' for live Groq Vision API, 'true' for offline mock mode
AI_MOCK_MODE=false

# Groq Vision Model (Default: qwen/qwen3.8-27b)
GROQ_VISION_MODEL=qwen/qwen3.8-27b

# Optional Redis connection for real-time match event pub/sub
REDIS_URL=redis://localhost:6379
MATCH_EVENT_CHANNEL=match.found

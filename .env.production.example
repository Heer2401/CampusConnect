# ══════════════════════════════════════════════════════════════════
# CampusConnect — Production & Staging Environment Variables Template
# Use this when setting up Railway service variables
# ══════════════════════════════════════════════════════════════════

# ── 1. Backend Service Variables (Railway: campusconnect-backend) ──
NODE_ENV=production
PORT=5000
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.chs8np0.mongodb.net/campusconnect?retryWrites=true&w=majority
JWT_SECRET=campusconnect_super_secret_jwt_key_2026
CLIENT_URL=https://your-frontend-domain.railway.app
REDIS_URL=${{Redis.REDIS_URL}}
AI_SERVICE_URL=http://${{campusconnect-ai.RAILWAY_PRIVATE_DOMAIN}}:8001
AI_HEALTH_TIMEOUT_MS=5000
LISTING_AUTO_APPROVE=true
IMAGE_STORAGE=local

# Optional Cloudinary (for persistent image uploads on cloud containers)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ── 2. AI Microservice Variables (Railway: campusconnect-ai) ──
PORT=8001
GROQ_API_KEY=your_groq_api_key_here
AI_MOCK_MODE=false
GROQ_VISION_MODEL=qwen/qwen3.8-27b
REDIS_URL=${{Redis.REDIS_URL}}
MATCH_EVENT_CHANNEL=match.found

# ── 3. Frontend Service Variables (Railway: campusconnect-frontend) ──
VITE_API_URL=https://your-backend-domain.railway.app

